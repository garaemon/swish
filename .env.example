## Copy this file to `apps/web/.env.local` (gitignored) before running
## `pnpm --filter web dev`. Next.js loads the file from the app directory,
## so this template at the repo root is reference-only.
##
## The database is the `DB` Cloudflare D1 binding declared in
## apps/web/wrangler.jsonc, not an environment variable. Create its tables
## locally with `pnpm --filter web db:migrate:local`.

## AES-256-GCM master key for encrypting per-user API keys.
## Generate with:
##   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MASTER_KEY=

## JWT signing secret for Personal Access Tokens.
## Generate with:
##   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

## Better Auth secret (signs session cookies). At least 32 characters.
## Generate with:
##   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
BETTER_AUTH_SECRET=

## Emails allowed to create an account at /signup (comma-separated, or `*`
## for anyone). Leave empty to disable sign-up.
SIGNUP_ALLOWED_EMAILS=

## Public URL of the running web app (used by the bookmarklet template and
## as Better Auth's base URL).
NEXT_PUBLIC_APP_URL=http://localhost:3000

## Optional: override the Gemini generateContent endpoint. Leave unset to
## use https://generativelanguage.googleapis.com/v1beta/models.
# GEMINI_API_ENDPOINT=
