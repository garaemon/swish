## Copy this file to `apps/web/.env.local` (gitignored) before running
## `pnpm --filter web dev`. Next.js loads the file from the app directory,
## so this template at the repo root is reference-only.

## Supabase local stack
## After `supabase start`, copy these from the printed output.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

## AES-256-GCM master key for encrypting per-user API keys.
## Generate with:
##   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MASTER_KEY=

## JWT signing secret for Personal Access Tokens.
## Generate with:
##   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

## Public URL of the running web app (used by the bookmarklet template).
NEXT_PUBLIC_APP_URL=http://localhost:3000

## Optional: iCloud link of the shared "Save to Swish" iOS shortcut template.
## When set, the settings page shows a one-tap "Add shortcut" button instead
## of manual setup steps. See docs/ios-shortcut-template.md for how to create
## and share the template once.
# NEXT_PUBLIC_IOS_SHORTCUT_TEMPLATE_URL=

## Optional: override the Gemini generateContent endpoint. Leave unset to
## use https://generativelanguage.googleapis.com/v1beta/models.
# GEMINI_API_ENDPOINT=
