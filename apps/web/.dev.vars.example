# Runtime variables for `opennextjs-cloudflare preview` / `wrangler dev`
# (local workerd). Copy to `.dev.vars` and fill in. Mirrors the keys in the
# repo-root `.env.example`.
#
# `next dev` reads `.env.local` instead — `.dev.vars` only applies to the
# workerd preview path. The D1 database is a binding (wrangler.jsonc), not a
# variable; run `pnpm --filter web db:migrate:local` once to create tables.

NEXT_PUBLIC_APP_URL=http://localhost:8787

MASTER_KEY=
JWT_SECRET=
BETTER_AUTH_SECRET=
SIGNUP_ALLOWED_EMAILS=
